# --- Monad testnet RPC (free, public) ---
# Verified working: chain id 10143
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz

# Whale threshold in native MON for the live feed (default 10).
# Monad testnet is quiet — typical blocks carry <20 MON transfers — so the
# demo default is relative, not mainnet-scale. Raise for mainnet.
WHALE_THRESHOLD_MON=10

# How many recent blocks to scan per poll (default 3)
SCAN_BLOCKS=3

# --- LLM (OpenAI-compatible). At least one key recommended for the AI Explain feature ---
# KIMI (Moonshot AI) — https://platform.moonshot.ai
KIMI_API_KEY=
KIMI_API_BASE=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2-0711-preview

# QWEN (Alibaba Cloud, OpenAI-compatible mode) — https://bailian.console.aliyun.com
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Which provider to use first: "kimi" or "qwen" (falls back to the other if its key is set)
LLM_PROVIDER=kimi

# --- Nansen (optional enrichment: address labels / smart-money tags) ---
NANSEN_API_KEY=
# Override if Nansen gives you a custom base URL / endpoint path for the address-label API
NANSEN_API_BASE=https://api.nansen.ai
